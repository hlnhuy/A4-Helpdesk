# Sao chep file nay thanh ".env" (cung thu muc backend/) roi sua cho dung may cua ban.

# --- SQL Server (Windows Authentication, instance SQLEXPRESS02) ---
# Dung odbc_connect de tranh loi dau "\" trong ten instance.
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BSERVER%3Dlocalhost%5CSQLEXPRESS02%3BDATABASE%3DA4Helpdesk%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes

# --- Neu dung tai khoan SQL (sa) thay cho Windows Authentication ---
# DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BSERVER%3Dlocalhost%5CSQLEXPRESS02%3BDATABASE%3DA4Helpdesk%3BUID%3Dsa%3BPWD%3DMatKhauCuaBan%3BTrustServerCertificate%3Dyes

# --- Bao mat ---
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRE_MINUTES=480

# --- Website React duoc phep goi API (cach nhau bang dau phay) ---
CORS_ORIGINS=http://localhost:5173

# --- Tep dinh kem ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Tai khoan Admin tu dong tao o lan chay dau tien (neu chua co Admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@a4.edu.vn
ADMIN_NAME=Quan tri vien

# --- Gui email quen mat khau (de trong = chi ghi ra console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=helpdesk@a4.edu.vn

# --- Chi bat khi chay test voi SQLite; voi SQL Server hay tao bang bang database/schema.sql ---
AUTO_CREATE_TABLES=false
